<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleDevelopmentRegion</key><string>en</string>
<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
<key>CFBundleName</key><string>GuardianAngel</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>0.1.0</string>
<key>CFBundleVersion</key><string>1</string>
<key>DJISDKAppKey</key><string>$(DJI_APP_KEY)</string>
<key>LSRequiresIPhoneOS</key><true/>
<key>UILaunchScreen</key><dict/>
<key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
<key>UISupportedExternalAccessoryProtocols</key><array>
<string>com.dji.video</string><string>com.dji.protocol</string><string>com.dji.common</string><string>com.dji.logiclink</string>
</array>
<key>NSLocalNetworkUsageDescription</key><string>Connect to your Guardian Angel command server and upload drone camera frames.</string>
<key>NSBluetoothAlwaysUsageDescription</key><string>The DJI SDK uses Bluetooth when connecting supported DJI accessories.</string>
<key>NSLocationWhenInUseUsageDescription</key><string>The DJI SDK may request location for aircraft connection and flight services.</string>
<key>NSAppTransportSecurity</key><dict>
<key>NSAllowsLocalNetworking</key><true/>
<key>NSAllowsArbitraryLoads</key><true/>
</dict>
</dict></plist>
